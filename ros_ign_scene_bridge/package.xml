<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros_ign_scene_bridge</name>
  <version>0.0.0</version>
  <description>Bridge Ignition Gazebo /world/scene/info topic to ROS via custom messages</description>
  <maintainer email="juuso.s.jarvenpaa@tuni.fi">Juuso Järvenpää</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>custom_msgs</depend>

  <depend>ignition-transport11</depend>
  <depend>ignition-msgs8</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>